{
  "name": "codex-account-switch-electron",
  "version": "1.3.17",
  "private": true,
  "description": "Electron shell for Codex Account Switch webui.",
  "main": "src/main.js",
  "scripts": {
    "dev": "electron .",
    "start": "electron .",
    "dist:mac": "electron-builder --mac",
    "dist:win": "electron-builder --win portable",
    "dist": "electron-builder"
  },
  "devDependencies": {
    "electron": "^42.3.3",
    "electron-builder": "^26.8.1"
  },
  "build": {
    "appId": "com.codex.accountswitch",
    "productName": "Codex Account Switch",
    "files": [
      "src/**/*"
    ],
    "extraResources": [
      {
        "from": "../webui",
        "to": "webui"
      }
    ],
    "directories": {
      "output": "dist"
    },
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "target": [
        "portable"
      ]
    }
  }
}
